{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "gunicorn app:app --bind 0.0.0.0:$PORT --worker-class gevent --workers 1 --timeout 0",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
